# ─── Database ────────────────────────────────────────────────────────────────
# Option A: local Docker (see docker-compose.yml — run `docker compose up -d`)
DATABASE_URL="postgresql://biosense:biosense@localhost:5432/biosense"
# Option B: Neon / Supabase free tier
# DATABASE_URL="postgresql://user:password@host:5432/biosense?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-your-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Anthropic (Claude AI) ────────────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=""

# ─── Cloudflare R2 (PDF storage) ─────────────────────────────────────────────
# Leave blank to skip file uploads in local dev
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="biosense-pdfs"
R2_PUBLIC_URL=""

# ─── Stripe ───────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com  — leave blank to skip billing (no paywall) in local dev
# Members pay on the marketing site (https://bio-sense.ai/pricing), not in the iOS app.
# Webhook stays on THIS app (where accounts live). Stripe POSTs to it; opening it
# in a browser is not a page. Endpoint:
#   https://bio-sense-app-navy.vercel.app/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MONTHLY_PRICE_ID=""
STRIPE_ANNUAL_PRICE_ID=""

# ─── Resend (transactional email) ─────────────────────────────────────────────
# https://resend.com — leave blank to skip email in local dev
RESEND_API_KEY=""
EMAIL_FROM="BioSense <noreply@yourdomain.com>"
# Optional: bounce/complaint endpoint /api/webhooks/resend
RESEND_WEBHOOK_SECRET=""

# Founder lookup at /ops (leave blank to disable)
OPS_SECRET=""

# ─── Terra API (unified wearable aggregator) ──────────────────────────────────
# https://dashboard.tryterra.co — one integration covers 500+ devices/apps.
# Use the TESTING/dev environment keys for local development.
# Each Terra environment (testing/staging/production) has its OWN dev-id + key.
TERRA_DEV_ID=""
TERRA_API_KEY=""
# Generated when you add a Webhook "Destination" in the Terra dashboard.
# Leave blank in local dev to skip signature verification (NEVER blank in prod).
TERRA_SIGNING_SECRET=""

# ─── Legacy direct wearable OAuth (superseded by Terra) ───────────────────────
# Leave blank — wearable connect buttons will show but OAuth won't complete.
# Slated for removal once the Terra flow is verified end-to-end.
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""

WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""

GARMIN_CONSUMER_KEY=""
GARMIN_CONSUMER_SECRET=""
