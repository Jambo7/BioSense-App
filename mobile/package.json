{
  "name": "biosense-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "BioSense native shells (Capacitor). iOS TestFlight and Android Play both load the production web app.",
  "scripts": {
    "sync": "npx cap sync ios && node scripts/patch-ios-plugins.cjs",
    "sync:android": "npx cap sync android",
    "open": "npx cap open ios",
    "open:android": "npx cap open android",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.8.3"
  }
}
